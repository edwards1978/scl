{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp",
                "--env=local"
            ],
            "environment": {
                "LOG_CHANNEL": "stderr"
            }
        }
    }
}
